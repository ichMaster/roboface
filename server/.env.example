# RoboFace — server configuration. Copy to server/.env and fill in the blanks.
# See specification/ARCHITECTURE.md §Configuration and secrets.
# The firmware holds no key of its own — only WiFi credentials and the server URL.

# --- Chat + vision -----------------------------------------------------------
# Gemini is the only chat vendor in this project (MISSION §Principles).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash          # chat + the vision turn (multimodal, v3.1)
GEMINI_THINKING_BUDGET=0               # thinking off: lowest time-to-first-token
GEMINI_EMOTION_MODEL=gemini-2.5-flash  # the background emotion read (v3.3)
GEMINI_GROUNDING=off                   # google_search grounding, the one tool (v4.3)
GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# --- TTS: ElevenLabs (v1.1) --------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                   # the ElevenLabs voice id RoboFace speaks in
ELEVENLABS_MODEL=eleven_turbo_v2_5     # multilingual, handles Ukrainian
ELEVENLABS_OUTPUT_FORMAT=pcm_16000     # matches the device's playback format exactly

# --- ASR: Deepgram (v1.3) ----------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=uk
DEEPGRAM_ENCODING=linear16             # PCM16, the uplink format
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_ENDPOINT_MS=500               # end-of-utterance pause for the server-side endpointer

# --- Server ------------------------------------------------------------------
ROBOFACE_WS_HOST=0.0.0.0
ROBOFACE_WS_PORT=8000                  # 8000 is the product; codegen's dashboard owns 8420
ROBOFACE_FACE_SET=stackchan            # default skin: stackchan | ghost | flame | jelly | cloud
ROBOFACE_CANON_PATH=server/canon.md    # the character (v4.1)
ROBOFACE_LOG_LEVEL=info

# --- World context (v4.4) — each source is individually optional --------------
LOCATION=
WEATHER_URL=
NEWS_API_KEY=
